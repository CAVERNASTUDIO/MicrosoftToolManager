<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationIcon>ico.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>true</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    
    <AssemblyName>MicrosoftToolManager</AssemblyName>
    <RootNamespace>Microsoft Tool Manager </RootNamespace>
    <Version>1.0.0</Version>
    <Title>Microsoft Console Application Tool Manager C#</Title>
    <Authors>Erik Alejandro García Aparicio</Authors>
    <Company>Caverna Studio / Projecto Scriptorium</Company>
    <Product>Tool Manager</Product>
    <Description>Microsoft User Administration Tool</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="\ico.ico" />
    <PackageReference Include="CavernaStudio.Licenses" Version="1.0.0" />
  </ItemGroup>

</Project>
